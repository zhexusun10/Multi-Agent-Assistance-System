{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "valid": {
      "type": "boolean"
    },
    "issues": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "quote": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "quote",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "valid",
    "issues"
  ],
  "additionalProperties": false
}
