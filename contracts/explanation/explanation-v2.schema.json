{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "2.0"
    },
    "focus_listing_ids": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "paragraphs": {
      "minItems": 1,
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "support_refs": {
            "minItems": 1,
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "text",
          "support_refs"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "focus_listing_ids",
    "paragraphs"
  ],
  "additionalProperties": false
}
