{
  "$defs": {
    "AppointmentSignal": {
      "additionalProperties": false,
      "description": "One entry per listing: every non-draft VIEWING action status and action ID for it.",
      "properties": {
        "action_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Action Ids",
          "type": "array"
        },
        "listing_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Listing Id",
          "type": "string"
        },
        "statuses": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Statuses",
          "type": "array"
        }
      },
      "required": [
        "listing_id",
        "statuses",
        "action_ids"
      ],
      "title": "AppointmentSignal",
      "type": "object"
    },
    "BrowsingRecord": {
      "additionalProperties": false,
      "properties": {
        "duration_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Seconds"
        },
        "listing_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Listing Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "recorded",
            "missing"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "listing_id",
        "status"
      ],
      "title": "BrowsingRecord",
      "type": "object"
    },
    "PreviousRound": {
      "additionalProperties": false,
      "properties": {
        "browsing": {
          "items": {
            "$ref": "#/$defs/BrowsingRecord"
          },
          "title": "Browsing",
          "type": "array"
        },
        "request_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "shown_listing_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Shown Listing Ids",
          "type": "array"
        }
      },
      "required": [
        "request_id",
        "shown_listing_ids",
        "browsing"
      ],
      "title": "PreviousRound",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "appointments": {
      "items": {
        "$ref": "#/$defs/AppointmentSignal"
      },
      "title": "Appointments",
      "type": "array"
    },
    "previous_round": {
      "anyOf": [
        {
          "$ref": "#/$defs/PreviousRound"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "title": "FeedbackSnapshot",
  "type": "object"
}
