{
  "$defs": {
    "ColdStartDiagnostics": {
      "additionalProperties": false,
      "description": "mpd-v1: D = mean absolute pairwise difference of the first ``candidate_window`` official\ncombined scores of O; active = D < threshold. D describes score spread only.",
      "properties": {
        "active": {
          "title": "Active",
          "type": "boolean"
        },
        "candidate_window": {
          "anyOf": [
            {
              "minimum": 2,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Window"
        },
        "detector": {
          "const": "mean_pairwise_difference",
          "title": "Detector",
          "type": "string"
        },
        "detector_version": {
          "const": "mpd-v1",
          "title": "Detector Version",
          "type": "string"
        },
        "evaluated": {
          "title": "Evaluated",
          "type": "boolean"
        },
        "evaluated_count": {
          "anyOf": [
            {
              "minimum": 2,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evaluated Count"
        },
        "mean_pairwise_difference": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean Pairwise Difference"
        },
        "pool_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pool Key"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "threshold": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        }
      },
      "required": [
        "evaluated",
        "active",
        "reason",
        "detector",
        "detector_version"
      ],
      "title": "ColdStartDiagnostics",
      "type": "object"
    },
    "ColdStartThresholds": {
      "additionalProperties": false,
      "properties": {
        "b": {
          "minimum": 1,
          "title": "B",
          "type": "integer"
