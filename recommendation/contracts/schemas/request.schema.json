{
  "$defs": {
    "AppointmentSignal": {
      "additionalProperties": false,
      "description": "One entry per listing: every non-draft VIEWING action status and action ID for it.",
      "properties": {
        "action_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Action Ids",
          "type": "array"
        },
        "listing_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Listing Id",
          "type": "string"
        },
        "statuses": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Statuses",
          "type": "array"
        }
      },
      "required": [
        "listing_id",
        "statuses",
        "action_ids"
      ],
      "title": "AppointmentSignal",
      "type": "object"
    },
    "BrowsingRecord": {
      "additionalProperties": false,
      "properties": {
        "duration_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Seconds"
        },
        "listing_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Listing Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "recorded",
            "missing"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "listing_id",
        "status"
      ],
      "title": "BrowsingRecord",
      "type": "object"
    },
    "ColdStartInput": {
      "additionalProperties": false,
      "description": "Cold-start exit state managed by the orchestrator (no native history).",
      "properties": {
        "exited": {
          "default": false,
          "title": "Exited",
          "type": "boolean"
        },
        "exited_pool_key": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exited Pool Key"
        }
      },
      "title": "ColdStartInput",
      "type": "object"
    },
    "Criterion": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category"
        },
        "criterion_id": {
          "minLength": 1,
          "title": "Criterion Id",
          "type": "string"
        },
        "destination_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Destination Id"
        },
        "destination_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Destination Name"
        },
        "distance_type": {
          "anyOf": [
            {
              "enum": [
                "straight_line",
                "walking",
                "transit"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distance Type"
        },
        "field": {
          "enum": [
            "price",
            "bedrooms",
            "floor_area_sqft",
            "district_code",
            "property_type",
            "distance",
            "commute",
            "furnishing",
            "availability",
            "lease_months"
          ],
          "title": "Field",
          "type": "string"
        },
        "operator": {
          "enum": [
            "eq",
            "in",
            "gte",
            "lte",
            "between"
          ],
          "title": "Operator",
          "type": "string"
        },
        "strength": {
          "enum": [
            "hard",
            "soft"
          ],
          "title": "Strength",
          "type": "string"
        },
        "transport_mode": {
          "anyOf": [
            {
              "enum": [
                "walk",
                "transit",
                "drive"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transport Mode"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "utility": {
          "default": "threshold",
          "enum": [
            "threshold",
            "proximity",
            "minimize",
            "maximize"
          ],
          "title": "Utility",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "title": "Value"
        },
        "weight": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "criterion_id",
        "field",
        "operator",
        "value",
        "strength"
      ],
      "title": "Criterion",
      "type": "object"
    },
    "FeedbackSnapshot": {
      "additionalProperties": false,
      "properties": {
        "appointments": {
          "items": {
            "$ref": "#/$defs/AppointmentSignal"
          },
          "title": "Appointments",
          "type": "array"
        },
        "previous_round": {
          "anyOf": [
            {
              "$ref": "#/$defs/PreviousRound"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "FeedbackSnapshot",
      "type": "object"
    },
    "PreviousRound": {
      "additionalProperties": false,
      "properties": {
        "browsing": {
          "items": {
            "$ref": "#/$defs/BrowsingRecord"
          },
          "title": "Browsing",
          "type": "array"
        },
        "request_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "shown_listing_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Shown Listing Ids",
          "type": "array"
        }
      },
      "required": [
        "request_id",
        "shown_listing_ids",
        "browsing"
      ],
      "title": "PreviousRound",
      "type": "object"
    },
    "Requirements": {
      "additionalProperties": false,
      "properties": {
        "criteria": {
          "items": {
            "$ref": "#/$defs/Criterion"
          },
          "title": "Criteria",
          "type": "array"
        },
        "listing_type": {
          "const": "RENT",
          "default": "RENT",
          "title": "Listing Type",
          "type": "string"
        }
      },
      "required": [
        "criteria"
      ],
      "title": "Requirements",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cold_start": {
      "$ref": "#/$defs/ColdStartInput"
    },
    "contract_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Contract Version",
      "type": "string"
    },
    "conversation_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Conversation Id",
      "type": "string"
    },
    "feedback": {
      "$ref": "#/$defs/FeedbackSnapshot"
    },
    "previous_state_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous State Id"
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "requirements": {
      "$ref": "#/$defs/Requirements"
    },
    "requirements_version": {
      "minimum": 1,
      "title": "Requirements Version",
      "type": "integer"
    },
    "result_limit": {
      "anyOf": [
        {
          "maximum": 10,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result Limit"
    }
  },
  "required": [
    "request_id",
    "conversation_id",
    "requirements_version",
    "requirements"
  ],
  "title": "RecommendationRequest",
  "type": "object"
}
