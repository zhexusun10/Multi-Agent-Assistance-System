{
  "$defs": {
    "BehaviorContext": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "book_viewing_listings": {
          "items": {
            "$ref": "#/$defs/BookViewingListing"
          },
          "title": "Book Viewing Listings",
          "type": "array"
        },
        "listing_view_durations": {
          "items": {
            "$ref": "#/$defs/ListingViewDuration"
          },
          "title": "Listing View Durations",
          "type": "array"
        },
        "version": {
          "const": "1.0",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "as_of",
        "listing_view_durations",
        "book_viewing_listings"
      ],
      "title": "BehaviorContext",
      "type": "object"
    },
    "BookViewingListing": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "format": "uuid",
          "title": "Action Id",
          "type": "string"
        },
        "appointment_confirmed": {
          "const": false,
          "title": "Appointment Confirmed",
          "type": "boolean"
        },
        "ends_at": {
          "format": "date-time",
          "title": "Ends At",
          "type": "string"
        },
        "listing_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Listing Id",
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "requirements_version": {
          "minimum": 0,
          "title": "Requirements Version",
          "type": "integer"
        },
        "signal": {
          "const": "viewing_draft_saved",
          "title": "Signal",
          "type": "string"
        },
        "source_request_id": {
          "format": "uuid",
          "title": "Source Request Id",
          "type": "string"
        },
        "starts_at": {
          "format": "date-time",
          "title": "Starts At",
          "type": "string"
        },
        "time_zone": {
          "const": "Asia/Singapore",
          "title": "Time Zone",
          "type": "string"
        }
      },
      "required": [
        "listing_id",
        "action_id",
        "source_request_id",
        "requirements_version",
        "starts_at",
        "ends_at",
        "time_zone",
        "recorded_at",
        "signal",
        "appointment_confirmed"
      ],
      "title": "BookViewingListing",
      "type": "object"
    },
    "ColdStartInput": {
      "additionalProperties": false,
      "description": "Cold-start exit state managed by the orchestrator (no native history).",
      "properties": {
        "exited": {
          "default": false,
          "title": "Exited",
          "type": "boolean"
        },
        "exited_pool_key": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exited Pool Key"
        }
      },
      "title": "ColdStartInput",
      "type": "object"
    },
    "Criterion": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category"
        },
        "criterion_id": {
          "minLength": 1,
          "title": "Criterion Id",
          "type": "string"
        },
        "destination_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Destination Id"
        },
        "destination_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Destination Name"
        },
        "distance_type": {
          "anyOf": [
            {
              "enum": [
                "straight_line",
                "walking",
                "transit"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distance Type"
        },
        "field": {
          "enum": [
            "price",
            "bedrooms",
            "floor_area_sqft",
            "district_code",
            "property_type",
            "distance",
            "commute",
            "furnishing",
            "availability",
            "lease_months"
          ],
          "title": "Field",
          "type": "string"
        },
        "operator": {
          "enum": [
            "eq",
            "in",
            "gte",
            "lte",
            "between"
          ],
          "title": "Operator",
          "type": "string"
        },
        "strength": {
          "enum": [
            "hard",
            "soft"
          ],
          "title": "Strength",
          "type": "string"
        },
        "transport_mode": {
          "anyOf": [
            {
              "enum": [
                "walk",
                "transit",
                "drive"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transport Mode"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "utility": {
          "default": "threshold",
          "enum": [
            "threshold",
            "proximity",
            "minimize",
            "maximize"
          ],
          "title": "Utility",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "title": "Value"
        },
        "weight": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "criterion_id",
        "field",
        "operator",
        "value",
        "strength"
      ],
      "title": "Criterion",
      "type": "object"
    },
    "ListingViewDuration": {
      "additionalProperties": false,
      "properties": {
        "duration_seconds": {
          "minimum": 0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "interest_eligible": {
          "title": "Interest Eligible",
          "type": "boolean"
        },
        "last_viewed_at": {
          "format": "date-time",
          "title": "Last Viewed At",
          "type": "string"
        },
        "listing_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Listing Id",
          "type": "string"
        },
        "source_request_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Request Ids",
          "type": "array"
        },
        "view_count": {
          "minimum": 1,
          "title": "View Count",
          "type": "integer"
        }
      },
      "required": [
        "listing_id",
        "duration_seconds",
        "view_count",
        "last_viewed_at",
        "source_request_ids",
        "interest_eligible"
      ],
      "title": "ListingViewDuration",
      "type": "object"
    },
    "Requirements": {
      "additionalProperties": false,
      "properties": {
        "criteria": {
          "items": {
            "$ref": "#/$defs/Criterion"
          },
          "title": "Criteria",
          "type": "array"
        },
        "listing_type": {
          "const": "RENT",
          "default": "RENT",
          "title": "Listing Type",
          "type": "string"
        }
      },
      "required": [
        "criteria"
      ],
      "title": "Requirements",
      "type": "object"
    },
    "ViewPayload": {
      "additionalProperties": false,
      "properties": {
        "duration_seconds": {
          "minimum": 0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "view_session_id": {
          "minLength": 1,
          "title": "View Session Id",
          "type": "string"
        }
      },
      "required": [
        "view_session_id",
        "duration_seconds"
      ],
      "title": "ViewPayload",
      "type": "object"
    },
    "ViewingEvent": {
      "additionalProperties": false,
      "description": "Incremental, quality-gated duration event (main contract). Validated, not scored:\nbehavior_context.listing_view_durations already holds the same time cumulatively.",
      "properties": {
        "conversation_id": {
          "minLength": 1,
          "title": "Conversation Id",
          "type": "string"
        },
        "event_id": {
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "event_type": {
          "const": "listing_view_duration",
          "default": "listing_view_duration",
          "title": "Event Type",
          "type": "string"
        },
        "listing_id": {
          "minLength": 1,
          "title": "Listing Id",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/ViewPayload"
        },
        "recommendation_request_id": {
          "minLength": 1,
          "title": "Recommendation Request Id",
          "type": "string"
        },
        "source": {
          "default": "sample",
          "enum": [
            "sample",
            "web_detail"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "conversation_id",
        "recommendation_request_id",
        "listing_id",
        "occurred_at",
        "payload"
      ],
      "title": "ViewingEvent",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "behavior_context": {
      "anyOf": [
        {
          "$ref": "#/$defs/BehaviorContext"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "cold_start": {
      "$ref": "#/$defs/ColdStartInput"
    },
    "contract_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Contract Version",
      "type": "string"
    },
    "conversation_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Conversation Id",
      "type": "string"
    },
    "feedback": {
      "items": {
        "$ref": "#/$defs/ViewingEvent"
      },
      "title": "Feedback",
      "type": "array"
    },
    "previous_state_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous State Id"
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "requirements": {
      "$ref": "#/$defs/Requirements"
    },
    "requirements_version": {
      "minimum": 1,
      "title": "Requirements Version",
      "type": "integer"
    },
    "result_limit": {
      "anyOf": [
        {
          "maximum": 10,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result Limit"
    }
  },
  "required": [
    "request_id",
    "conversation_id",
    "requirements_version",
    "requirements"
  ],
  "title": "RecommendationRequest",
  "type": "object"
}
