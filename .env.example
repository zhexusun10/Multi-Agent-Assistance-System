CHAT_MODEL=openai:gpt-4.1-mini
OPENAI_API_KEY=
# Other providers: set CHAT_MODEL=anthropic:<model> with ANTHROPIC_API_KEY,
# or CHAT_MODEL=google-genai:<model> with GOOGLE_API_KEY.
# Optional OpenAI-compatible endpoint (only for CHAT_MODEL=openai:...)
# OPENAI_BASE_URL=
GRAPH_HOST=127.0.0.1
GRAPH_PORT=3001
GRAPH_SERVICE_URL=http://127.0.0.1:3001
# Local PostgreSQL example. Add a password after the role name if your server requires one.
DATABASE_URL=postgresql://multi_agent_assistance@127.0.0.1:5432/multi_agent_assistance
TEST_DATABASE_URL=postgresql://multi_agent_assistance@127.0.0.1:5432/multi_agent_assistance_test

# Separate PropertyGuru ingestion PostgreSQL database (NOT the LangGraph DATABASE_URL).
# Create role/database first; add a password to this URL in your ignored .env if needed.
PROPERTYGURU_DATABASE_URL=postgresql+psycopg2://propertyguru_scraper@127.0.0.1:5432/propertyguru
# Optional: only for isolated, temporary-schema persistence tests; never point at production.
# PROPERTYGURU_TEST_DATABASE_URL=postgresql+psycopg2://propertyguru_scraper@127.0.0.1:5432/propertyguru_test

# Optional local Neo4j projection. Compose and the Python CLI must use the same credentials.
# Set a unique password in .env before first `docker compose --env-file .env -f propertyguru_scraper/compose.yaml up -d`.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-this-local-password
NEO4J_DATABASE=neo4j
