CHAT_MODEL=openai:gpt-4.1-mini
OPENAI_API_KEY=
# Other providers: set CHAT_MODEL=anthropic:<model> with ANTHROPIC_API_KEY,
# or CHAT_MODEL=google-genai:<model> with GOOGLE_API_KEY.
# Optional OpenAI-compatible endpoint (only for CHAT_MODEL=openai:...)
# OPENAI_BASE_URL=
GRAPH_HOST=127.0.0.1
GRAPH_PORT=3001
GRAPH_SERVICE_URL=http://127.0.0.1:3001
# Local PostgreSQL example. Add a password after the role name if your server requires one.
DATABASE_URL=postgresql://multi_agent_assistance@127.0.0.1:5432/multi_agent_assistance
TEST_DATABASE_URL=postgresql://multi_agent_assistance@127.0.0.1:5432/multi_agent_assistance_test

# Separate PropertyGuru ingestion PostgreSQL database (NOT the LangGraph DATABASE_URL).
# Create role/database first; add a password to this URL in your ignored .env if needed.
PROPERTYGURU_DATABASE_URL=postgresql+psycopg2://propertyguru_scraper@127.0.0.1:5432/propertyguru
# Fixed listing snapshot: 2026-10-09. API defaults to PostgreSQL, never a hidden SQLite fallback.
# For explicit SQLite exploration use: python data/knowledge_graph.py serve --sqlite data/propertyguru.db
# Optional read-only PostgreSQL role for the API (falls back to the ingestion URL only if unset).
# PROPERTYGURU_READ_DATABASE_URL=postgresql+psycopg2://propertyguru_reader@127.0.0.1:5432/propertyguru
# Optional: only for isolated, temporary-schema persistence tests; never point at production.
# PROPERTYGURU_TEST_DATABASE_URL=postgresql+psycopg2://propertyguru_scraper@127.0.0.1:5432/propertyguru_test
# Opt-in read-only full-snapshot SQL + Neo4j + HTTP contract acceptance (uses the configured data services):
# PROPERTYGURU_VERIFY_LIVE=1

# Local development only: password-free Neo4j, ports must stay bound to loopback.
# Never expose this configuration to a LAN/public network or through a proxy.
NEO4J_AUTH=none
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_BROWSER_URL=http://127.0.0.1:7474/browser/
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# Runnable historical-sample workbench. Full mode requires the verified full snapshot; supports canonical-scan baseline or remote recommendation agent.
BUSINESS_ENABLED=true
LLM_MODE=auto
DATA_MODE=sample
DATASET_VERSION=historical-csv-main-0c45bf3
DATA_API_URL=http://127.0.0.1:8089
DATA_BUNDLE_MANIFEST_PATH=./data/.runtime/sample-data-bundle.json
SAMPLE_PROPERTYGURU_DATABASE_URL=postgresql+psycopg2://propertyguru_scraper@127.0.0.1:5432/propertyguru_sample
SAMPLE_NEO4J_URI=bolt://127.0.0.1:7688
RECOMMENDATION_MODE=native
RECOMMENDATION_API_URL=http://127.0.0.1:8092
RECOMMENDATION_CONTROLLER=live
RECOMMENDATION_DATA_MODE=database
RECOMMENDATION_STATE_PATH=./data/.runtime/recommendation/state.sqlite
# Internal loopback service credential; start-app.ps1 generates one if empty.
RECOMMENDATION_SERVICE_TOKEN=
# Dedicated recommendation agent model (Python LangChain, recommendation/agent/llm.py). Required when
# RECOMMENDATION_CONTROLLER=live; never falls back to CHAT_MODEL / OPENAI_* above. OpenAI-compatible only.
RECOMMENDATION_LLM_PROVIDER=openai
RECOMMENDATION_LLM_MODEL=
RECOMMENDATION_LLM_API_KEY=
# Optional OpenAI-compatible endpoint (api.deepseek.com gets thinking disabled):
# RECOMMENDATION_LLM_BASE_URL=
# Optional (defaults): temperature 0, provider output-token default, 60 s per request (capped by the run's
# controller.timeout_seconds), 0 SDK retries.
# RECOMMENDATION_LLM_TEMPERATURE=0
# RECOMMENDATION_LLM_MAX_TOKENS=4096
# RECOMMENDATION_LLM_TIMEOUT_SECONDS=60
# RECOMMENDATION_LLM_MAX_RETRIES=0
RECOMMENDATION_HTTP_TIMEOUT_MS=450000
# Recommendation settings come from recommendation/settings/recommendation.yaml (single source).
# Full-pool multi-location evidence needs more wall time: the overlay file below changes only
# controller.timeout_seconds (300 s) on top of the committed YAML.
RECOMMENDATION_CONFIG=config/recommendation-full.json
# Any other alternative file of the same schema (YAML or JSON, or an {"extends":"committed","overrides":{...}}
# overlay) is for tests/experiments only:
# RECOMMENDATION_CONFIG=./recommendation/examples/config.json
EXTERNAL_ACTION_MODE=simulation
# Set live only after configuring the provider and reviewing the exact recipient/body.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# polling works on localhost; webhook needs a reachable HTTPS endpoint; never run both.
TELEGRAM_RECEIVE_MODE=webhook
PUBLIC_BASE_URL=
# Optional read-only listing database for scoped public salesperson contact hints.
CONTACT_DATABASE_URL=
KNOWLEDGE_MODE=hybrid_rrf
# Local Chroma Docker server and the Python vector/BM25 retrieval service.
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8002
RETRIEVAL_URL=http://127.0.0.1:8091
APP_PORT=8010
# To restore authentication, set the actual account password in Neo4j first,
# then remove NEO4J_AUTH=none and provide the same NEO4J_USER/NEO4J_PASSWORD.

# Keep manual duration samples out of the normal customer UI.
UI_DEVELOPER_MODE=false

# Requirement cards follow native response selection.cold_start.active; off disables.
REQUIREMENT_REFINEMENT_MODE=native
