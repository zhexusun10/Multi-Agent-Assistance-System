CHAT_MODEL=openai:gpt-4.1-mini
OPENAI_API_KEY=
# Other providers: set CHAT_MODEL=anthropic:<model> with ANTHROPIC_API_KEY,
# or CHAT_MODEL=google-genai:<model> with GOOGLE_API_KEY.
# Optional OpenAI-compatible endpoint (only for CHAT_MODEL=openai:...)
# OPENAI_BASE_URL=
GRAPH_HOST=127.0.0.1
GRAPH_PORT=3001
GRAPH_SERVICE_URL=http://127.0.0.1:3001
# Local PostgreSQL example. Add a password after the role name if your server requires one.
DATABASE_URL=postgresql://multi_agent_assistance@127.0.0.1:5432/multi_agent_assistance
TEST_DATABASE_URL=postgresql://multi_agent_assistance@127.0.0.1:5432/multi_agent_assistance_test
